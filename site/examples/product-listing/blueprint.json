                "badge": "신상"
              },
              {
                "type": "card",
                "title": "독서등",
                "body": "29,000원",
                "variant": "media",
                "visual": "photo",
                "ratio": "1:1"
              },
              {
                "type": "card",
                "title": "플로어 램프",
                "body": "129,000원",
                "variant": "media",
                "visual": "photo",
                "ratio": "1:1"
              },
              {
                "type": "card",
                "title": "센서 무드등",
                "body": "19,000원",
                "variant": "media",
