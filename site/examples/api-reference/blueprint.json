                        "team",
                        "쿼리",
                        "문자열",
                        "팀 ID. 생략하면 토큰의 기본 팀"
                      ],
                      [
                        "download",
                        "쿼리",
                        "불리언",
                        "true면 결과물 본문을 바로 내려받음"
                      ]
                    ],
                    "state": "ready"
                  },
                  {
                    "type": "tabs",
                    "variant": "underline",
                    "children": [
                      {
                        "type": "tab",
                        "label": "curl",
                        "children": [
                          {
                            "type": "code",
                            "label": "요청",
                            "language": "bash",
                            "code": "curl -H \"Authorization: Bearer $BUILDFLOW_TOKEN\" \\\n  https://api.example.com/v3/cache/9f2c1a?team=web"
                          }
                        ]
                      },
                      {
                        "type": "tab",
                        "label": "JavaScript",
                        "children": [
                          {
                            "type": "code",
                            "label": "요청",
                            "language": "js",
                            "code": "const res = await fetch(\"https://api.example.com/v3/cache/9f2c1a\", {\n  headers: {Authorization: `Bearer ${process.env.BUILDFLOW_TOKEN}`},\n});\nconst {size, createdAt} = await res.json();"
                          }
                        ]
                      }
                    ]
                  }
                ],
                "anchor": "get"
              },
              {
                "type": "section",
                "title": "캐시 저장",
                "children": [
                  {
                    "type": "prose",
                    "title": "PUT /v3/cache/{hash}",
                    "body": "작업 결과물을 올립니다. 같은 해시에 다시 올리면 기존 항목을 덮어쓰지 않고 성공으로 응답합니다."
                  },
                  {
                    "type": "code",
                    "label": "응답 예시",
                    "language": "json",
                    "code": "{\n  \"hash\": \"9f2c1a\",\n  \"size\": 482113,\n  \"createdAt\": \"2026-10-20T08:12:44Z\"\n}"
                  },
                  {
                    "type": "notice",
                    "tone": "warning",
                    "title": "크기 제한",
                    "body": "한 항목은 최대 200MB입니다. 더 큰 결과물은 나누어 올려야 합니다."
                  }
                ],
                "anchor": "put"
              },
