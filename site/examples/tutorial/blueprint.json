{
  "version": "2.0",
  "catalogVersion": "2.0.0",
  "name": "매뉴얼",
  "theme": "manual",
  "palette": "moonlit-mist",
  "mode": "light",
  "pageType": "docs",
  "shell": "topbar",
  "typography": "sans",
  "density": "comfortable",
  "radius": "subtle",
  "control": "match",
  "elevation": "outline",
  "motion": "none",
  "icon": "line",
  "ornament": "none",
  "backdrop": "plain",
  "width": "wide",
  "scale": "tight",
  "weight": "medium",
  "footer": "simple",
  "chrome": {
    "nav": [
      {
        "label": "시작하기",
        "href": "#main",
        "icon": "book"
      },
      {
        "label": "튜토리얼",
        "href": "#main",
        "icon": "play"
      },
      {
        "label": "레퍼런스",
        "href": "#main",
        "icon": "code"
      }
    ],
    "footerNote": "매뉴얼 · 정적 데모",
    "footerLinks": [
      {
        "label": "이용약관",
        "href": "#main"
      },
      {
        "label": "개인정보",
        "href": "#main"
      },
      {
        "label": "문의",
        "href": "#main"
      }
    ]
  },
  "tree": {
    "type": "page",
    "children": [
      {
        "type": "page-header",
        "title": "첫 화면 만들기",
        "description": "15분 안에 Blueprint 하나로 완성합니다.",
        "eyebrow": "튜토리얼"
      },
      {
        "type": "stepper",
        "steps": [
          "준비",
          "작성",
          "검증",
          "빌드"
        ],
        "current": 2
      },
      {
        "type": "aside",
        "side": "end",
        "size": "wide",
        "sticky": "yes",
        "label": "이 단계의 명령어",
        "children": [
          {
            "type": "steps",
            "title": "따라 하기",
            "items": [
              {
                "title": "예제 복사",
                "description": "examples 폴더에서 가까운 예제를 복사합니다."
              },
              {
                "title": "값 고르기",
                "description": "테마, 팔레트, 셸을 카탈로그에서 고릅니다."
              },
              {
                "title": "검증",
                "description": "validate 명령으로 오류를 확인합니다. 오류 경로와 규칙 ID를 읽고 카탈로그 안의 값으로 고칩니다."
              },
              {
                "title": "빌드",
                "description": "build 명령으로 HTML을 만들고 check 명령으로 산출물을 한 번 더 검사합니다."
              }
            ]
          },
          {
            "type": "code",
            "label": "검증과 빌드",
            "language": "bash",
            "code": "npm run kit -- validate my.json\nnpm run kit -- build my.json --out out/my\nnpm run kit -- check out/my"
          }
        ]
      },
      {
        "type": "notice",
        "tone": "success",
        "title": "여기까지 오셨다면",
        "body": "out/my/index.html을 브라우저로 열어 확인하세요."
      }
    ]
  }
}
