      {
        "label": "이용약관",
        "href": "#main"
      },
      {
        "label": "개인정보",
        "href": "#main"
      },
      {
        "label": "문의",
        "href": "#main"
      }
    ]
  },
  "tree": {
    "type": "page",
    "children": [
      {
        "type": "page-header",
        "title": "비밀번호 재설정",
