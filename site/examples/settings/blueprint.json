{
  "version": "1.0",
  "catalogVersion": "1.0.0",
  "name": "설정과 입력",
  "theme": "workspace",
  "palette": "ocean",
  "mode": "light",
  "shell": "sidebar",
  "typography": "sans",
  "density": "comfortable",
  "radius": "soft",
  "tree": {
    "type": "page",
    "children": [
      {
        "type": "page-header",
        "title": "작업 환경을 나답게.",
        "description": "설정은 언제든 바꿀 수 있습니다."
      },
      {
        "type": "form",
        "title": "프로필 설정",
        "fields": [
          {
            "id": "name",
            "label": "이름",
            "type": "text",
            "placeholder": "이름을 입력하세요"
          },
          {
            "id": "email",
            "label": "이메일",
            "type": "email",
            "placeholder": "name@example.com"
          },
          {
            "id": "role",
            "label": "주로 하는 일",
            "type": "select",
            "options": [
              "디자인",
              "개발",
              "기획"
            ]
          },
          {
            "id": "intro",
            "label": "소개",
            "type": "textarea",
            "placeholder": "어떤 일을 하고 있나요?"
          }
        ],
        "submitLabel": "입력 확인"
      },
      {
        "type": "notice",
        "tone": "info",
        "title": "이 화면은 데모입니다.",
        "body": "입력 형식만 브라우저에서 확인하며 서버에 저장하지 않습니다."
      }
    ]
  }
}
