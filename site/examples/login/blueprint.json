          {
            "id": "password",
            "label": "비밀번호",
            "type": "password",
            "help": "8자 이상 · 비밀번호를 잊으셨다면 아래에서 재설정하세요."
          }
        ],
        "submitLabel": "로그인"
      },
      {
        "type": "divider",
        "label": "또는"
      },
      {
        "type": "actions",
        "items": [
          {
            "label": "Google 계정으로 계속하기",
            "href": "#main",
            "variant": "secondary"
          },
          {
            "label": "카카오 계정으로 계속하기",
            "href": "#main",
            "variant": "secondary"
          },
          {
            "label": "비밀번호를 잊으셨나요?",
            "href": "#main",
            "variant": "ghost"
          }
        ]
